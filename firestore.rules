rules_version = '2';

// ============================================================
// قواعد أمان Firestore — منصة مستر عادل عزت (المشروع: clinic-nour)
//
// نمط الوصول الفعلي للتطبيق (من app.js):
//   - القراءة:  getDoc(doc(db, "academy", "adelEzzat"))
//   - الكتابة:  setDoc(doc(db, "academy", "adelEzzat"), db)  ← كتابة كاملة للمستند
//   - لا يوجد Firebase Authentication في التطبيق (الدخول بالأكواد
//     يتم على العميل)، لذلك كل الطلبات تصل كـ anonymous requests.
//   - كل البيانات (students, attendance, quizzes, submissions,
//     lessons, forum, settings) مصفوفات داخل هذا المستند الواحد،
//     ولا يوجد subcollections مستخدمة حالياً.
//
// لذلك: يجب السماح بالوصول المفتوح لهذا المستند تحديداً حتى تعمل
// المنصة لكل الطلاب والمستر، مع إغلاق كل شيء آخر نهائياً.
//
// ⚠ ملاحظة أمان مهمة: "allow if true" يعني أي شخص يعرف رابط
//   الموقع يستطيع قراءة/تعديل بيانات المنصة (بما فيها أكواد
//   الطلاب وكلمة سر اللوحة). هذا مقبول لفصل صغير والاستخدام
//   العائلي — ونسخة مقوّاة بالـ Authentication موجودة في
//   التعليقات أسفل الملف للترقية لاحقاً.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // 1) منصة مستر عادل عزت: المستند الرئيسي + أي subcollections
    //    تحت مساره (مخصص لأي تطوير مستقبلي).
    // ----------------------------------------------------------
    match /academy/adelEzzat {
      allow read, write: if true;

      // subcollections تحت المستند (غير مستخدمة حالياً في app.js)
      match /{subPath=**} {
        allow read, write: if true;
      }
    }

    // ----------------------------------------------------------
    // 2) تطبيق العيادة القديم (clinic-old/) يعمل على مستند
    //    clinic/main في نفس المشروع — يجب ألا نكسره.
    // ----------------------------------------------------------
    match /clinic/main {
      allow read, write: if true;
    }

    // ----------------------------------------------------------
    // 3) منع كل شيء آخر نهائياً (deny-by-default صريح).
    //    ملاحظة: Firestore يطبق OR بين القواعد المتطابقة، لذلك
    //    هذا الحظر لا يلغي السماح أعلاه — إنه يغطي فقط المسارات
    //    التي لم يسمح بها أي match قبله.
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // نسخة مقوّاة (اختياري — للترقية المستقبلية):
    //
    // 1) فعّل Anonymous Authentication في Firebase Console:
    //    Authentication → Sign-in method → Anonymous → Enable
    // 2) في app.js استورد signInAnonymously من firebase-auth
    //    ونفّذها عند التحميل.
    // 3) استبدل قاعدة المستند أعلاه بـ:
    //
    // match /academy/adelEzzat {
    //   allow read, write: if request.auth != null;
    // }
    //
    // هذا يمنع أي أداة خارجية من الاتصال مباشرة بـ API المشروع
    // بدون مرور من الموقع، مع بقاء المنصة تعمل بنفس النمط.
    // ============================================================
  }
}
